# Veriterra — variables d'environnement (Tranche 0).
# Copier en `.env` à la racine et renseigner. NE JAMAIS committer de secrets.
# En dev local, `pnpm dev` / `pnpm db:*` chargent ce fichier via dotenv-cli.
# En docker-compose et en CI, les variables sont injectées par service / par le job.

# --- Auth.js (v5) ---
# Secret de signature des sessions JWT. Générer avec : openssl rand -base64 33
AUTH_SECRET=change-me
# Origine publique de l'app (derrière Caddy en prod, ex. https://foncier.tondomaine.fr).
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# --- Pocket ID (OIDC) ---
# issuer = base de la découverte OIDC (sans /.well-known/openid-configuration).
# Enregistrer le redirect_uri EXACT côté Pocket ID : <AUTH_URL>/api/auth/callback/pocket-id
AUTH_POCKET_ID_ISSUER=https://id.exemple.fr
AUTH_POCKET_ID_ID=change-me
AUTH_POCKET_ID_SECRET=change-me

# --- PostgreSQL + PostGIS ---
# DATABASE_URL : rôle applicatif RESTREINT `veriterra_app` (ni superuser, ni BYPASSRLS,
# ni propriétaire) — utilisé par l'app et le worker à l'exécution. RLS le contraint.
# La migration RLS crée ce rôle avec le mot de passe dev `veriterra_app` (IF NOT EXISTS).
# EN PROD : pré-provisionner le rôle avec un secret fort AVANT la migration (qui le saute
# alors) et faire correspondre ce mot de passe ici.
DATABASE_URL=postgresql://veriterra_app:veriterra_app@localhost:5432/veriterra?schema=public
# DIRECT_URL : rôle PRIVILÉGIÉ (owner/superuser) — utilisé UNIQUEMENT par
# `prisma migrate deploy`, les seeds et le bootstrap auth. Jamais pour des données tenant.
DIRECT_URL=postgresql://veriterra:veriterra@localhost:5432/veriterra?schema=public

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Postgres (image docker, rôle superuser initial) ---
POSTGRES_USER=veriterra
POSTGRES_PASSWORD=veriterra
POSTGRES_DB=veriterra

# --- Stockage objet (MinIO / S3) ---
# Pièces jointes aux terrains (photos, documents). MinIO reste sur le réseau interne :
# l'app est le seul intermédiaire (upload et download passent par elle). Secrets côté serveur.
# MINIO_ROOT_USER/PASSWORD initialisent l'image MinIO (docker-compose) ; les S3_* configurent
# le client côté app (mêmes identifiants en dev).
MINIO_ROOT_USER=veriterra
MINIO_ROOT_PASSWORD=veriterra-minio
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=veriterra
S3_ACCESS_KEY_ID=veriterra
S3_SECRET_ACCESS_KEY=veriterra-minio
# MinIO adresse les buckets par chemin (endpoint/bucket/clé), laisser true.
S3_FORCE_PATH_STYLE=true
# Taille maximale d'un fichier déposé, en Mo.
S3_MAX_UPLOAD_MB=25
