# Veriterra — variables d'environnement PROD (à coller dans l'éditeur .env d'Arcane).
# Remplir TOUTES les valeurs. Ne jamais committer le .env réel.
# Les hôtes db / redis = noms de service compose (réseau interne de la stack).

# --- Postgres (rôle superuser initial du conteneur) ---
POSTGRES_USER=veriterra
POSTGRES_PASSWORD=__CHANGER_secret_fort__
POSTGRES_DB=veriterra

# --- Connexions base ---
# App/worker : rôle RESTREINT veriterra_app. La migration le crée avec le mot de passe
# 'veriterra_app' (IF NOT EXISTS). DURCISSEMENT prod recommandé : après le 1er déploiement,
#   ALTER ROLE veriterra_app PASSWORD '<fort>';
# puis remplacer le mot de passe ci-dessous.
DATABASE_URL=postgresql://veriterra_app:veriterra_app@db:5432/veriterra?schema=public
# Migrations + bootstrap auth : rôle privilégié (= superuser ci-dessus).
DIRECT_URL=postgresql://veriterra:__CHANGER_secret_fort__@db:5432/veriterra?schema=public

# --- Redis ---
REDIS_URL=redis://redis:6379

# --- Stockage objet (MinIO / S3) ---
# Pièces jointes aux terrains. MinIO reste sur le réseau INTERNE (jamais exposé à Caddy) :
# l'app est le seul intermédiaire. Choisir des identifiants FORTS (secrets prod).
# MINIO_ROOT_USER/PASSWORD initialisent l'image ; les S3_* doivent correspondre.
MINIO_ROOT_USER=veriterra
MINIO_ROOT_PASSWORD=__CHANGER_secret_fort__
# Hôte = nom de service compose (réseau interne de la stack).
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=veriterra
S3_ACCESS_KEY_ID=veriterra
S3_SECRET_ACCESS_KEY=__CHANGER_secret_fort__
S3_FORCE_PATH_STYLE=true
S3_MAX_UPLOAD_MB=25

# --- Réseau Caddy (externe) ---
# Nom du réseau Docker de ton Caddy, auquel le service `veriterra` se rattache.
CADDY_NETWORK=caddy

# --- Auth.js / OIDC Pocket ID ---
# openssl rand -base64 33
AUTH_SECRET=__CHANGER_secret_fort__
AUTH_URL=https://veriterra.lukas-houille.com
AUTH_TRUST_HOST=true
AUTH_POCKET_ID_ISSUER=https://id.tondomaine.fr
AUTH_POCKET_ID_ID=__client_id_pocket_id__
AUTH_POCKET_ID_SECRET=__client_secret_pocket_id__
# Enregistrer le redirect_uri EXACT côté Pocket ID :
#   https://veriterra.lukas-houille.com/api/auth/callback/pocket-id

# --- Admin plateforme (US-8.1) ---
# E-mails autorisés sur /admin (comptes, organisations, monitoring), séparés par des virgules.
# Vide = aucun admin plateforme.
ADMIN_EMAILS=
