// Veriterra — schéma de données (Tranche 0, socle).
//
// Invariant multi-tenant : chaque donnée propre à un tenant porte `organisationId`
// et est protégée par Row-Level Security PostgreSQL (voir la migration RLS). Le client
// applicatif se connecte via `DATABASE_URL` avec le rôle restreint `veriterra_app`
// (ni superuser, ni BYPASSRLS, ni propriétaire) ; les migrations et le bootstrap auth
// utilisent `DIRECT_URL` (rôle privilégié).

generator client {
  provider = "prisma-client-js"
  // Emitted as a sibling of src/ and dist/ so the SAME relative import
  // `../generated/prisma` resolves whether running from source or from the build.
  output   = "../generated/prisma"
}

// Prisma 7 : la chaîne de connexion vit dans `prisma.config.ts` (CLI : migrate/seed) et
// l'adapter est passé au PrismaClient (runtime). Le bloc datasource ne garde que le provider.
datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  ADMIN
  MEMBER
}

/// Tenant racine. Une organisation par utilisateur en Tranche 0 (créée en silence à
/// la première connexion). Le partage multi-membres viendra plus tard, sans migration.
model Organisation {
  id          String            @id @default(uuid()) @db.Uuid
  name        String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  memberships Membership[]
  terrains    Terrain[]
  parcelles   TerrainParcelle[]
  projets     Projet[]
  enrichments EnrichmentBlock[]
}

/// Type de maison visé par le projet de l'acheteur (nombre de niveaux).
enum TypeMaison {
  PLAIN_PIED
  R1
  R2
  R3
}

/// Projet immobilier de l'acheteur (cahier des charges §5). Défini à l'onboarding (court),
/// tout devient relatif à lui (score, ombres, enveloppe, effet complet en Tranche 3). Table
/// scopée au tenant (RLS). `consentementPartage` prépare la future marketplace (opt-in).
model Projet {
  id                  String      @id @default(uuid()) @db.Uuid
  organisationId      String      @db.Uuid
  name                String      @default("Mon projet")
  budgetMax           Decimal?    @db.Decimal(12, 2)
  surfaceMinM2        Int?
  surfaceMaxM2        Int?
  typeMaison          TypeMaison?
  consentementPartage Boolean     @default(false)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  terrains     Terrain[]

  @@index([organisationId])
}

/// Identité globale, liée au sujet OIDC (Pocket ID). Clé de jointure = `oidcSubject`
/// (le `sub` OIDC), jamais l'email (mutable). Table non scopée à un tenant : on n'y
/// accède que par la voie privilégiée (bootstrap auth), pas par les requêtes tenant.
model User {
  id          String       @id @default(uuid()) @db.Uuid
  oidcSubject String       @unique
  email       String?
  name        String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  memberships Membership[]
}

/// Appartenance d'un utilisateur à une organisation, avec rôle. Table scopée au tenant
/// (porte `organisationId`) : protégée par RLS.
model Membership {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @db.Uuid
  organisationId String   @db.Uuid
  role           Role     @default(MEMBER)
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@unique([userId, organisationId])
  @@index([organisationId])
}

/// Statut d'un terrain dans le portefeuille (aligné sur `StatusPin` de @veriterra/ui).
/// Le pipeline complet de statuts (US-5.1) viendra en Tranche 5.
enum TerrainStatus {
  A_ETUDIER
  PROMETTEUR
  RESERVE
  ECARTE
}

/// Fiche terrain (Tranche 1). Table scopée au tenant (`organisationId`) : protégée par RLS.
model Terrain {
  id             String        @id @default(uuid()) @db.Uuid
  organisationId String        @db.Uuid
  label          String
  address        String
  inseeCode      String
  prixDemande    Decimal?      @db.Decimal(12, 2)
  lienAnnonce    String?
  notes          String?
  status         TerrainStatus @default(A_ETUDIER)
  projetId       String?       @db.Uuid
  createdById    String?       @db.Uuid
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organisation Organisation      @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  projet       Projet?           @relation(fields: [projetId], references: [id], onDelete: SetNull)
  parcelles    TerrainParcelle[]
  enrichments  EnrichmentBlock[]

  @@index([organisationId])
  @@index([projetId])
}

/// Parcelle cadastrale rattachée à un terrain (embarquée, pas de table Parcelle globale).
/// Données faisant autorité re-récupérées côté serveur par `idu` (source + date).
/// `geom` est la géométrie PostGIS (SRID 4326) ; on lit `geojson` pour l'affichage.
model TerrainParcelle {
  id             String                                       @id @default(uuid()) @db.Uuid
  organisationId String                                       @db.Uuid
  terrainId      String                                       @db.Uuid
  idu            String
  commune        String
  section        String
  numero         String
  surfaceM2      Int
  geojson        Json
  geom           Unsupported("geometry(MultiPolygon, 4326)")?
  source         String
  fetchedAt      DateTime                                     @default(now())

  terrain      Terrain      @relation(fields: [terrainId], references: [id], onDelete: Cascade)
  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@index([organisationId])
  @@index([terrainId])
  @@index([idu])
}

/// Type de bloc d'enrichissement (Tranche 2). Extensible sans nouvelle table : on commence par
/// RISQUES (Géorisques), PRIX_DVF, PLU, PENTE et SERVICES suivront.
enum EnrichmentType {
  RISQUES
  PRIX_DVF
  PLU
  PENTE
  SERVICES
}

/// Statut d'un bloc. UNAVAILABLE = donnée indisponible comme cas de première classe (règle 3),
/// jamais une valeur par défaut silencieuse. ERROR = échec de récupération (réessayable).
enum EnrichmentStatus {
  PENDING
  OK
  UNAVAILABLE
  ERROR
}

/// Indice de confiance d'une donnée sourcée (règle 1).
enum ConfidenceLevel {
  ELEVEE
  MOYENNE
  FAIBLE
}

/// Bloc d'enrichissement sourcé rattaché à un terrain (Tranche 2). Un bloc par couple
/// (terrain, type). Table scopée au tenant (`organisationId`) : protégée par RLS. Le payload
/// normalisé vit dans `data` (Json), avec sa provenance (`source`, `sourceUrl`, `fetchedAt`) et
/// son indice de confiance. Écrit par le worker via `forOrg`/`withOrg`.
model EnrichmentBlock {
  id             String           @id @default(uuid()) @db.Uuid
  organisationId String           @db.Uuid
  terrainId      String           @db.Uuid
  type           EnrichmentType
  status         EnrichmentStatus @default(PENDING)
  data           Json?
  source         String?
  sourceUrl      String?
  confidence     ConfidenceLevel?
  fetchedAt      DateTime?
  error          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  terrain      Terrain      @relation(fields: [terrainId], references: [id], onDelete: Cascade)

  @@unique([terrainId, type])
  @@index([organisationId])
  @@index([terrainId])
}
